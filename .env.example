# Copia questo file in .env.local (solo per provare l'app sul computer) oppure
# inserisci le due variabili in Vercel > Settings > Environment Variables.
# Le trovi in Supabase > Project Settings > API (o "Data API" / "API Keys").
#
# Usa SOLO la chiave pubblica: "anon" oppure "publishable".
# La chiave "service_role" / "secret" non va mai messa qui né condivisa.
VITE_SUPABASE_URL=https://il-tuo-progetto.supabase.co
VITE_SUPABASE_ANON_KEY=la-chiave-pubblica-anon
